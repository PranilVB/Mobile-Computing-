<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_screen"
        android:paddingEnd="@dimen/margin_screen"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <!-- Empty state: no active token -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="@dimen/space_32"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_no_token"
                android:textSize="16sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_browse_services"
                style="@style/Widget.SmartQueue.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/btn_browse_services" />
        </LinearLayout>

        <!-- Token card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_token"
            style="@style/Widget.SmartQueue.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_24"
                android:gravity="center_horizontal">

                <!-- Service name -->
                <TextView
                    android:id="@+id/tv_service_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="center"
                    android:text="Document Verification" />

                <!-- Token number — largest element on screen per spec (36sp) -->
                <TextView
                    android:id="@+id/tv_token_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.SmartQueue.TokenNumber"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="A-018" />

                <!-- Status label -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="Waiting" />

                <!-- Called banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_called_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:visibility="gone"
                    app:cardBackgroundColor="#E8F5EE"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_12"
                        android:text="@string/msg_token_called"
                        android:textSize="14sp"
                        android:textColor="@color/color_success"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/color_border"
                    android:layout_marginTop="@dimen/space_20" />

                <!-- People ahead -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_people_ahead"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_people_ahead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:text="4" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:background="@color/color_border" />

                <!-- Estimated wait -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_estimated_wait"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_estimated_wait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:text="About 20 min" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:background="@color/color_border" />

                <!-- Now serving -->
                <LinearLayout
                    android:id="@+id/layout_now_serving"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_now_serving"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_now_serving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/color_text_primary"
                        android:text="A-014" />
                </LinearLayout>

                <!-- Updated time -->
                <TextView
                    android:id="@+id/tv_updated_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_updated_just_now"
                    android:textSize="12sp"
                    android:textColor="@color/color_text_secondary"
                    android:gravity="end"
                    android:layout_marginTop="@dimen/space_12" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cancel token (destructive text button, only while waiting) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_token"
            style="@style/Widget.SmartQueue.Button.TextDestructive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/btn_cancel_token"
            android:visibility="gone" />

        <!-- Loading -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_32"
            app:indicatorColor="@color/color_primary"
            app:trackColor="@color/color_border"
            app:indicatorSize="32dp" />

    </LinearLayout>
</ScrollView>
