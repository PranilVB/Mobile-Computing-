<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_screen"
        android:paddingEnd="@dimen/margin_screen"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <!-- Service title -->
        <TextView
            android:id="@+id/tv_service_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.SmartQueue.Title"
            android:text="Fee Payment" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_service_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginTop="@dimen/space_8"
            android:text="Pay college fees and collect receipts." />

        <!-- Info card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartQueue.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- Queue status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_queue_status"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_queue_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color_success"
                        android:textStyle="bold"
                        android:text="Open" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:background="@color/color_border" />

                <!-- People waiting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_people_waiting_count"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_people_waiting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:text="6" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:background="@color/color_border" />

                <!-- Estimated wait -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_estimated_wait"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_secondary" />
                    <TextView
                        android:id="@+id/tv_estimated_wait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:text="About 30 min" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclaimer_wait_times"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginTop="@dimen/space_12" />

        <!-- Error message -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/color_error"
            android:textSize="14sp"
            android:layout_marginTop="@dimen/space_12" />

        <!-- Get token button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_get_token"
            style="@style/Widget.SmartQueue.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/btn_get_token" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            app:indicatorColor="@color/color_primary"
            app:trackColor="@color/color_border"
            app:indicatorSize="24dp" />

    </LinearLayout>
</ScrollView>
