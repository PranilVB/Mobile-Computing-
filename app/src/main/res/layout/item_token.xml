<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SmartQueue.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_16"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_token_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/color_primary"
                android:textStyle="bold"
                android:text="A-015" />

            <TextView
                android:id="@+id/tv_token_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary"
                android:layout_marginTop="@dimen/space_2"
                android:text="Waiting" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_issue_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginEnd="@dimen/space_8"
            android:text="10:32 AM" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/color_text_secondary"
            android:contentDescription="View token actions" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
