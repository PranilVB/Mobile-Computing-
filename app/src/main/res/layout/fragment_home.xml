<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Offline banner -->
    <TextView
        android:id="@+id/tv_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_warning"
        android:textColor="@color/color_on_primary"
        android:text="@string/banner_offline"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_32">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margin_screen"
                android:paddingEnd="@dimen/margin_screen">

                <TextView
                    android:id="@+id/tv_app_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_display"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/color_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_choose_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heading_choose_service"
                    style="@style/TextAppearance.SmartQueue.Title"
                    android:layout_marginTop="@dimen/space_8" />
            </LinearLayout>

            <!-- Active token strip -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_active_token"
                style="@style/Widget.SmartQueue.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_screen"
                android:layout_marginEnd="@dimen/margin_screen"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_active_token_strip">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_active_token"
                            android:textSize="11sp"
                            android:textColor="@color/color_text_secondary"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/space_4">

                            <TextView
                                android:id="@+id/tv_active_token_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/color_primary"
                                android:textStyle="bold"
                                android:text="A-018" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" · "
                                android:textColor="@color/color_text_secondary" />

                            <TextView
                                android:id="@+id/tv_active_token_service"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/color_text_secondary"
                                android:text="Document Verification" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" · "
                                android:textColor="@color/color_text_secondary" />

                            <TextView
                                android:id="@+id/tv_active_token_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/color_text_secondary"
                                android:text="Waiting" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_next"
                        android:tint="@color/color_text_secondary"
                        android:contentDescription="@string/cd_active_token_strip" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/color_border"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginStart="@dimen/margin_screen"
                android:layout_marginEnd="@dimen/margin_screen" />

            <!-- Loading -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_8"
                app:indicatorColor="@color/color_primary"
                app:trackColor="@color/color_border" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_no_services"
                android:textSize="15sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:padding="@dimen/space_32"
                android:visibility="gone" />

            <!-- Services list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/margin_screen"
                android:paddingEnd="@dimen/margin_screen"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
