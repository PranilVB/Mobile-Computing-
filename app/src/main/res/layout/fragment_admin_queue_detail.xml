<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Status header card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.SmartQueue.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginEnd="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- Waiting count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_waiting_count"
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary" />
                <TextView
                    android:id="@+id/tv_waiting_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:text="8" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:background="@color/color_border" />

            <!-- Now serving -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_now_serving_admin"
                    android:textSize="14sp"
                    android:textColor="@color/color_text_secondary" />
                <TextView
                    android:id="@+id/tv_now_serving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/color_text_primary"
                    android:text="A-014" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Call next button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_call_next"
        style="@style/Widget.SmartQueue.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginEnd="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/btn_call_next" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_8"
        app:indicatorColor="@color/color_primary"
        app:trackColor="@color/color_border" />

    <!-- Queue section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Queue"
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginTop="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_8" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_admin_queue"
        android:textSize="15sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:padding="@dimen/space_32"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tokens"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/margin_screen"
        android:paddingEnd="@dimen/margin_screen"
        android:paddingBottom="@dimen/space_32"
        android:clipToPadding="false" />

</LinearLayout>
