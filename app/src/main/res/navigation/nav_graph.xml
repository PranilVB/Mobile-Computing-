<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- AUTH -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartqueue.auth.LoginFragment"
        android:label="Sign in"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/user_nav"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_admin"
            app:destination="@id/admin_nav"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.smartqueue.auth.RegisterFragment"
        android:label="Create account"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/user_nav"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- USER NAVIGATION -->
    <navigation
        android:id="@+id/user_nav"
        app:startDestination="@id/homeFragment">

        <fragment
            android:id="@+id/homeFragment"
            android:name="com.example.smartqueue.user.HomeFragment"
            android:label="@string/nav_home"
            tools:layout="@layout/fragment_home">
            <action
                android:id="@+id/action_home_to_service_detail"
                app:destination="@id/serviceDetailFragment" />
            <action
                android:id="@+id/action_home_to_my_token"
                app:destination="@id/myTokenFragment" />
        </fragment>

        <fragment
            android:id="@+id/serviceDetailFragment"
            android:name="com.example.smartqueue.user.ServiceDetailFragment"
            android:label="Service detail"
            tools:layout="@layout/fragment_service_detail">
            <argument
                android:name="serviceId"
                app:argType="string" />
            <argument
                android:name="serviceName"
                app:argType="string" />
            <action
                android:id="@+id/action_service_detail_to_my_token"
                app:destination="@id/myTokenFragment"
                app:popUpTo="@id/homeFragment" />
        </fragment>

        <fragment
            android:id="@+id/myTokenFragment"
            android:name="com.example.smartqueue.user.MyTokenFragment"
            android:label="@string/title_my_token"
            tools:layout="@layout/fragment_my_token">
            <action
                android:id="@+id/action_my_token_to_home"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/homeFragment"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/profileFragment"
            android:name="com.example.smartqueue.user.ProfileFragment"
            android:label="@string/title_profile"
            tools:layout="@layout/fragment_profile">
            <action
                android:id="@+id/action_profile_sign_out"
                app:destination="@id/loginFragment"
                app:popUpTo="@id/nav_graph"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

    <!-- ADMIN NAVIGATION -->
    <navigation
        android:id="@+id/admin_nav"
        app:startDestination="@id/adminQueuesFragment">

        <fragment
            android:id="@+id/adminQueuesFragment"
            android:name="com.example.smartqueue.admin.AdminQueuesFragment"
            android:label="@string/title_queues"
            tools:layout="@layout/fragment_admin_queues">
            <action
                android:id="@+id/action_admin_queues_to_detail"
                app:destination="@id/adminQueueDetailFragment" />
        </fragment>

        <fragment
            android:id="@+id/adminQueueDetailFragment"
            android:name="com.example.smartqueue.admin.AdminQueueDetailFragment"
            android:label="Service queue"
            tools:layout="@layout/fragment_admin_queue_detail">
            <argument
                android:name="serviceId"
                app:argType="string" />
            <argument
                android:name="serviceName"
                app:argType="string" />
        </fragment>

        <fragment
            android:id="@+id/profileFragment"
            android:name="com.example.smartqueue.user.ProfileFragment"
            android:label="@string/title_profile"
            tools:layout="@layout/fragment_profile">
            <action
                android:id="@+id/action_profile_sign_out"
                app:destination="@id/loginFragment"
                app:popUpTo="@id/nav_graph"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

</navigation>
